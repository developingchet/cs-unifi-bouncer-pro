# ============================================================================
# cs-unifi-bouncer-pro — Environment Configuration
# ============================================================================

# Values may be quoted with single or double quotes — both are handled transparently.
# CROWDSEC_LAPI_URL=https://crowdsec:8080        # bare value (fine)
# CROWDSEC_LAPI_URL='https://crowdsec:8080'      # single-quoted (fine)
# CROWDSEC_LAPI_URL="https://crowdsec:8080"      # double-quoted (fine)

# ╔══════════════════════════════════════╗
# ║  MINIMAL SETUP — 3 values required   ║
# ╚══════════════════════════════════════╝

UNIFI_URL=https://192.168.1.1          # Your controller IP or hostname
UNIFI_API_KEY=your-api-key-here        # Settings → Control Plane → Integrations
CROWDSEC_LAPI_KEY=your-bouncer-api-key-here  # from: cscli bouncers add unifi-bouncer

# ╔════════════════════════════════════════════════════════════════════════╗
# ║  COMMON OVERRIDES — change only if your setup differs from defaults    ║
# ╚════════════════════════════════════════════════════════════════════════╝

# Firewall mode: auto (default), legacy (sites without firewall zones, up to UniFi Network 10.x), or zone
# FIREWALL_MODE=auto

# Sites to protect — comma-separated UniFi site internal names
# UNIFI_SITES=default
# UNIFI_SITES=default,homelab,iot

# Automatically discover all sites on the controller (default: false).
# When true, UNIFI_SITES is ignored and all sites are used except those
# listed in UNIFI_SITES_EXCLUDE.
# UNIFI_SITES_AUTO=false

# Comma-separated list of site names to exclude when UNIFI_SITES_AUTO=true.
# UNIFI_SITES_EXCLUDE=guest,test

# Zone pairs — used when FIREWALL_MODE=zone or auto detects zone mode.
# Format: SourceZone[:srcPorts]->DestinationZone[:dstPorts][@dstIP1,dstIP2,...]
# Default is External->Dmz. Separate multiple pairs with semicolons.
# Use the exact zone names shown in Settings → Firewall → Zones.
# ZONE_PAIRS=External->Dmz
# ZONE_PAIRS=External->Dmz;External->Internal       # multiple pairs

# With optional port filters:
# ZONE_PAIRS=External:80,443->Internal              # only src ports 80 and 443
# ZONE_PAIRS=External->Internal:80,443              # only dst ports 80 and 443

# With optional destination IP filter (@ suffix on dst side):
# ZONE_PAIRS=External->Dmz@10.0.1.0/24             # scope to specific destination subnet
# ZONE_PAIRS=External->Internal:443@10.0.0.5       # dst port + dst IP filter
# ZONE_PAIRS=External->Dmz;External->Internal@10.0.0.0/24  # multiple pairs, second with dst IP

# A site/ prefix limits a pair to one site in UNIFI_SITES. A site with its
# own pairs uses only those; other sites use the pairs without a prefix.
# Works the same in EGRESS_ZONE_PAIRS and CLOUDFLARE_ZONE_PAIRS.
# ZONE_PAIRS=External->Dmz;branch/Wan->Lan         # branch names its zones differently

# Or read the pairs from a file, one pair per line; a SIGHUP reads it again,
# so the pairs change without a restart (EGRESS_ZONE_PAIRS_FILE and
# CLOUDFLARE_ZONE_PAIRS_FILE too). Mount
# the directory (for example ./config:/config:ro), not the single file: an
# editor that replaces the file on save leaves a file mount on the old copy.
# ZONE_PAIRS_FILE=/config/zone-pairs

# Username/password auth (legacy firewall rules only; use if no API key is available)
# UNIFI_USERNAME=admin
# UNIFI_PASSWORD=yourpassword
# UNIFI_USERNAME_FILE=/run/secrets/unifi_username
# UNIFI_PASSWORD_FILE=/run/secrets/unifi_password

# Process decisions without writing to UniFi — useful for initial testing
# DRY_RUN=false

# IPs/CIDRs that should never be blocked (comma-separated)
# BLOCK_WHITELIST=198.51.100.1          # replace with your public WAN IP; private ranges are skipped automatically

# Enable or disable IPv6 firewall rules
# FIREWALL_ENABLE_IPV6=true

# Enable or disable IPv6 connectivity for the HTTP client
# UNIFI_DIAL_IPV6=false
# Controls whether the HTTP client uses IPv6 to reach the UniFi controller.
# ENABLE_IPV6 is its deprecated name.
# Default false — keeps TCP dialing on IPv4 only, avoiding happy eyeballs
# stalls on hosts with IPv6 interfaces but no IPv6 route to the controller.
# FIREWALL_ENABLE_IPV6 is a separate setting that controls IPv6 firewall rules.

# Log verbosity: trace, debug, info, warn, error, fatal, panic
# LOG_LEVEL=info

# CrowdSec LAPI URL — change if not using the default Docker service name
CROWDSEC_LAPI_URL=https://crowdsec:8080
# A LAPI that only serves plain HTTP needs both lines below. Use them only on a
# trusted, same-host Docker network; a remote LAPI should use HTTPS.
# CROWDSEC_LAPI_URL=http://crowdsec:8080
# CROWDSEC_LAPI_ALLOW_HTTP=true

# ╔════════════════════════════════════════════════════════════════════════╗
# ║  ADVANCED — fine-tuning; defaults work well for most deployments       ║
# ╚════════════════════════════════════════════════════════════════════════╝

# --- UniFi Controller ---
# UNIFI_API_KEY_FILE=/run/secrets/unifi_api_key
# UNIFI_VERIFY_TLS=true                # false skips certificate validation and logs a warning
# UNIFI_CA_CERT=/etc/ssl/certs/my-unifi-ca.pem
# UNIFI_HTTP_TIMEOUT=120s
# UNIFI_API_DEBUG=false
# Reject plaintext UniFi controller connections (default: true).
# Set false explicitly only if your controller must use http://.
# UNIFI_REQUIRE_HTTPS=true

# --- Firewall ---
# FIREWALL_BLOCK_ACTION=drop           # drop or reject
# FIREWALL_API_SHARD_DELAY=250ms       # Pause before structural writes (new rules/policies, group deletes); membership updates are not delayed
# FIREWALL_LOG_DROPS=false
# FIREWALL_RECONCILE_ON_START=true
# FIREWALL_RECONCILE_INTERVAL=10m      # Periodic full reconcile; 0s disables it

# --- Shard Management ---
# Changed shards are written to UniFi after every decision batch. A write that
# fails is retried at this interval. Minimum: 5s. Default: 30s.
# SYNC_INTERVAL=30s

# Maximum IPs per shard: a Traffic Matching List in zone mode, a firewall group
# in legacy mode. When a shard is full, a new shard and its rule or zone
# policies are created automatically. UniFi holds at most 10,000 items per list.
# Default: 10000
# SHARD_LIMIT=10000
# Per-family limits, capped at SHARD_LIMIT; unset or 0 uses SHARD_LIMIT.
# They replace FIREWALL_GROUP_CAPACITY_V4 and FIREWALL_GROUP_CAPACITY_V6.
# SHARD_LIMIT_V4=10000
# SHARD_LIMIT_V6=5000

# Shards with this many IPs or fewer are eligible for consolidation into other shards.
# 0 = auto (50% of SHARD_LIMIT). Set to -1 to disable rebalancing.
# SHARD_MERGE_THRESHOLD=0

# --- Zone-Based Firewall ---
# Connection states matched by zone block policies: ALL, or a list of NEW, INVALID, ESTABLISHED.
# FIREWALL_CONNECTION_STATES=NEW,INVALID

# Egress pairs stop hosts in the source zone from connecting out to banned
# addresses, with the same ban lists. They need the zone-based firewall and
# UNIFI_API_KEY; a destination IP list (@...) is not allowed here.
# EGRESS_ZONE_PAIRS=Dmz->External;IoT->External
# EGRESS_ZONE_PAIRS_FILE=/config/egress-zone-pairs
# EGRESS_CONNECTION_STATES=NEW

# Every ban uses every pair in ZONE_PAIRS; there are no per-scenario zone pairs.

# --- Circuit Breaker ---
# Opens after N consecutive controller failures and resets after the interval.
# A failed shard write counts unless the controller answered 400 or 429; a failed reconcile
# read or policy check counts only on a transport error, a timeout, a 5xx or a 401.
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_INTERVAL=60s

# --- Legacy Firewall Mode (sites without firewall zones, up to UniFi Network 10.x) ---
# LEGACY_RULE_INDEX_START_V4=22000
# LEGACY_RULE_INDEX_START_V6=27000
# LEGACY_RULESET_V4=WAN_IN
# LEGACY_RULESET_V6=WANv6_IN

# --- Object Naming Templates (Go templates) ---
# Variables: .Family (v4/v6), .Index, .Site, .SrcZone, .DstZone
# GROUP_NAME_TEMPLATE=crowdsec-block-{{.Family}}-{{.Index}}
# RULE_NAME_TEMPLATE=crowdsec-drop-{{.Family}}-{{.Index}}
# POLICY_NAME_TEMPLATE=crowdsec-policy-{{.SrcZone}}-{{.DstZone}}-{{.Family}}-{{.Index}}
# OBJECT_DESCRIPTION=Managed by cs-unifi-bouncer-pro. Do not edit manually.

# --- CrowdSec LAPI ---
# CROWDSEC_LAPI_KEY_FILE=/run/secrets/crowdsec_lapi_key
# CROWDSEC_LAPI_VERIFY_TLS=true
# CROWDSEC_LAPI_CA_CERT=/etc/ssl/certs/crowdsec-ca.pem
# CROWDSEC_ORIGINS=crowdsec,lists
# CROWDSEC_POLL_INTERVAL=30s
# Re-read every active decision to recover bans the stream skipped.
# 0 disables; otherwise at least 5m. Default: 1h.
# CROWDSEC_RESYNC_INTERVAL=1h

# CrowdSec LAPI usage-metrics push interval. Set to 0 to disable.
# Minimum enforced value is 10m. Default: 30m.
# LAPI_METRICS_PUSH_INTERVAL=30m

# --- Decision Filtering ---
# CrowdSec decision types enforced as bans; a firewall can only block, so a
# captcha decision listed here blocks the address. Default: ban
# BLOCK_DECISION_TYPES=ban,captcha
# BLOCK_SCENARIO_EXCLUDE=impossible-travel,test
# BLOCK_MIN_DURATION=1h

# Override ban duration on a per-scenario basis. Comma- or semicolon-separated
# scenario=duration pairs; the longest matching key wins, and the override is
# not capped by BAN_TTL. Scenarios not listed use the duration supplied by CrowdSec.
# BLOCK_SCENARIO_DURATION_MAP=crowdsec/ssh-bf=168h,crowdsec/http-probing=24h

# --- Decision Rate Limiting ---
# Max CrowdSec decisions processed per second. 0 = unlimited (default).
# DECISION_RATE_LIMIT=0
# Burst size for the rate limiter (default: 1000).
# DECISION_BURST_SIZE=1000

# --- Session Management ---
# SESSION_REAUTH_MIN_GAP=5s
# SESSION_REAUTH_TIMEOUT=10s

# --- Storage ---
# DATA_DIR=/data
# BAN_TTL=168h
# Max ban, unban and expiry events kept in the database's history ring buffer (default: 10000).
# HISTORY_MAX_EVENTS=10000

# ─── External Blocklists ──────────────────────────────────────────────────────
# Fetch and block additional IP lists from external URLs (comma-separated).
# Lists are refreshed on the interval below and merged into the ban set.
# BLOCKLIST_URLS=https://example.com/blocklist.txt,https://example.com/other.txt
# BLOCKLIST_REFRESH_INTERVAL=24h
# Shortest prefix accepted for a feed entry. Raise to refuse broad ranges
# from feeds (IPv4: 8-32, IPv6: 32-128).
# BLOCKLIST_MIN_PREFIX_V4=8
# BLOCKLIST_MIN_PREFIX_V6=32

# AbuseIPDB list from github.com/borestad/blocklist-abuseipdb, filtered by country.
# Lists: 1d 3d 7d 14d 30d 60d 90d 120d 180d 365d (120d+ need an include filter).
# ABUSEIPDB_LIST=7d
# ABUSEIPDB_URL=                 # Optional mirror URL; default is the borestad GitHub raw file.
# ABUSEIPDB_COUNTRY_INCLUDE=CN,RU
# ABUSEIPDB_COUNTRY_EXCLUDE=US
# ABUSEIPDB_REFRESH_INTERVAL=6h

# ─── Webhook Notifications ───────────────────────────────────────────────────
# Send JSON POST notifications to a webhook URL on selected events.
# WEBHOOK_URL=https://hooks.example.com/notify
# Comma-separated list of events to send; empty sends all of them.
# Supported: circuit_breaker_open, circuit_breaker_close, reconcile_drift,
#   firewall_mode_changed, shard_create_failed, ban_entry_refused,
#   cloudflare_whitelist_sync_failed
# WEBHOOK_EVENTS=circuit_breaker_open,circuit_breaker_close,reconcile_drift

# ─── Cloudflare IP Whitelist ─────────────────────────────────────────────────
# Creates ALLOW policies with TML source filter for Cloudflare IP ranges.
# Zone pairs are INDEPENDENT of ZONE_PAIRS — configure separately.
# If you renamed your zones, check Settings → Firewall → Zones for the exact names.
# CLOUDFLARE_WHITELIST_ENABLED=false
# CLOUDFLARE_ZONE_PAIRS=External->Dmz;External->Internal
# Or read them from a file, one pair per line, which a SIGHUP reads again:
# CLOUDFLARE_ZONE_PAIRS_FILE=/config/cloudflare-zone-pairs
# CLOUDFLARE_REFRESH_INTERVAL=168h
# CLOUDFLARE_IPV4_URL=https://www.cloudflare.com/ips-v4
# CLOUDFLARE_IPV6_URL=https://www.cloudflare.com/ips-v6

# --- Observability ---
# LOG_FORMAT=json                      # json or text
# METRICS_ENABLED=true
# Listen addresses. The defaults (:9090 and :8081) bind all interfaces, which a
# container needs. On a host (for example under systemd) bind them to loopback:
# METRICS_ADDR=127.0.0.1:9090
# HEALTH_ADDR=127.0.0.1:8081
# HEALTH_CHECK_LAPI=true               # include CrowdSec LAPI reachability in /readyz after the first LAPI batch
# JANITOR_INTERVAL=1h
# SHUTDOWN_GRACE_PERIOD=30s
